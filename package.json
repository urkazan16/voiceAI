{
  "name": "localflow",
  "private": true,
  "version": "0.1.0",
  "description": "Local, private, CPU-first voice pipeline for macOS",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <23",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build:ui": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build": "npm run build:ui && cargo build --manifest-path src-tauri/Cargo.toml",
    "build:release": "node scripts/build-release.mjs",
    "test": "npm run test:frontend && npm run test:rust && npm run test:integration",
    "test:frontend": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked --lib",
    "test:integration": "cargo test --manifest-path src-tauri/Cargo.toml --locked --test integration",
    "test:all": "npm run test:frontend && cargo test --manifest-path src-tauri/Cargo.toml --locked && npm run test:ui && npm run test:pipeline && npm run test:dictionary && npm run test:personalization",
    "test:ui": "vitest run tests/ui",
    "test:pipeline": "cargo test --manifest-path src-tauri/Cargo.toml --locked pipeline --lib",
    "test:dictionary": "cargo test --manifest-path src-tauri/Cargo.toml --locked dictionary --lib",
    "test:personalization": "cargo test --manifest-path src-tauri/Cargo.toml --locked personalization --lib",
    "test:ai": "cargo test --manifest-path src-tauri/Cargo.toml --locked --features ai-bench --test ai_bench",
    "check": "tsc --noEmit && eslint . && prettier --check . && cargo check --manifest-path src-tauri/Cargo.toml --locked && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "license:check": "node scripts/license-check.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "audit": "npm audit --omit=dev && cargo audit --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "2.2.0",
    "@tauri-apps/plugin-clipboard-manager": "2.2.0",
    "@tauri-apps/plugin-global-shortcut": "2.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@tauri-apps/cli": "2.2.7",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "typescript-eslint": "8.69.0",
    "vite": "6.0.11",
    "vitest": "2.1.8"
  }
}
