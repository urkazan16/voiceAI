{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LocalFlow desktop capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:app:allow-default-window-icon",
    "core:webview:allow-internal-toggle-devtools",
    "allow-get-build-info",
    "allow-get-snapshot",
    "allow-get-settings",
    "allow-save-settings",
    "allow-list-models",
    "allow-list-microphones",
    "allow-list-dictionary",
    "allow-upsert-dictionary-entry",
    "allow-remove-dictionary-entry",
    "allow-export-configuration",
    "allow-import-configuration",
    "allow-list-history",
    "allow-delete-history",
    "allow-reset-personalization",
    "allow-process-transcript",
    "allow-complete-onboarding",
    "allow-privacy-summary",
    "allow-verify-model",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered"
  ]
}
